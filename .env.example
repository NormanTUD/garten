# Backend
# Generate a strong SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
DATABASE_URL=sqlite+aiosqlite:///./data/gartenapp.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-on-first-login

# CORS: comma-separated list of allowed origins, or "*" for all (dev only)
CORS_ORIGINS=*

# Frontend
VITE_API_BASE_URL=/api

# General
TZ=Europe/Berlin

# Postgres
POSTGRES_PASSWORD=gartenapp_secret
